# Copia este archivo como .streamlit/secrets.toml para correr la app localmente,
# o pega su contenido en Streamlit Cloud → App settings → Secrets.
#
# NUNCA subas el archivo secrets.toml real a GitHub (ya está en .gitignore).

SUPABASE_URL = "https://xxxxxxxxxxxxxxxx.supabase.co"

# Clave pública "anon". Es la que usa el navegador; está protegida por RLS.
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Clave "service_role". Solo se usa del lado del servidor para que la gerente
# pueda crear usuarios nuevos y restablecer contraseñas. Si prefieres no
# guardarla, deja el valor vacío: la app funcionará igual, pero la pantalla
# de alta de empleados quedará deshabilitada.
SUPABASE_SERVICE_KEY = ""
